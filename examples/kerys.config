// kerys.config — a bar that works with Kerys, the hotkey daemon.
//
//     Shell.exe examples\kerys.config
//
// Shows:
//   * the current Kerys binding mode, like a Hyprland submap indicator: it
//     appears when you press Win+Alt+R for resize mode and goes away on Escape
//   * whether Kerys is running, with a click to start or stop it
//   * a launcher that a Kerys hotkey opens and closes
//   * real battery, processor, memory, network and volume readings
//
// Add this to %USERPROFILE%\.config\kerys\kerys.toml and Win+Space toggles the
// launcher below. `shell ...` bindings go straight to this shell's control pipe:
//
//     [bindings]
//     "win+space" = "shell toggle launcher"
//     "win+shift+r" = "shell reload"
//
// Kerys tells the shell about every mode change by itself, so `kerys.mode`
// needs no setup. Any other program can do the same: `shellctl set kerys.mode
// resize` is the command-line version of what Kerys sends.

Theme {
    name: "kerys"
    dark: true
    radius: 8
    fontSize: 13
    accent: "#7c9cff"
    background: "#11111bf0"
    surface: "#1b1e29fa"
    foreground: "#e6e7ef"
    foregroundMuted: "#8b8fa3"
    warning: "#fbbf24"
    error: "#f87171"
}

Panel {
    position: "top"
    exclusive: true
    background: "background"
    height: 32
    padding: 0

    left {
        Row {
            gap: 12
            padding: [0, 12]
            cross: "center"

            Text { text: "Apps"  fontWeight: 600  onClick: shell.toggle("launcher") }

            // The binding mode. Hidden in the default mode, so it only takes
            // space when a mode is actually on and the keys mean something else.
            Text {
                text: kerys.mode
                color: "warning"
                fontWeight: 600
                visible: kerys.running && kerys.mode != "default"
            }
        }
    }

    center {
        Row { cross: "center"  Clock { format: "HH:mm" } }
    }

    right {
        Row {
            gap: 14
            padding: [0, 12]
            cross: "center"

            Text { text: "cpu " + system.cpuUsage + "%"  color: "foregroundMuted" }
            Text { text: "mem " + system.memoryUsage + "%"  color: "foregroundMuted" }
            Text {
                text: audio.muted ? "muted" : "vol " + audio.volume + "%"
                color: "foregroundMuted"
                visible: audio.available
                onClick: audio.toggleMute()
            }
            Text {
                text: battery.percentage + "%" + (battery.charging ? " +" : "")
                color: battery.percentage < 20 && !battery.plugged ? "error" : "foregroundMuted"
                visible: battery.present
            }
            Text { text: "offline"  color: "warning"  visible: !network.connected }

            // Kerys itself: dim when stopped, and a click flips it.
            Text {
                text: "keys"
                color: kerys.running ? "accent" : "foregroundMuted"
                onClick: kerys.toggle()
            }
        }
    }
}

// Opened and closed by `shell toggle launcher` from Kerys, `shellctl toggle
// launcher` from a terminal, or the "Apps" label above. Alt+F4 on it closes
// just the launcher.
Panel {
    name: "launcher"
    hidden: true
    position: "top"
    width: 460
    height: 40
    anchorX: 0.5
    background: "surface"
    border: "#ffffff1f"
    borderWidth: 1
    radius: 10
    padding: 0

    content {
        Row {
            gap: 14
            padding: [0, 16]
            cross: "center"
            Text { text: "Terminal"  onClick: launch("wt.exe") }
            Text { text: "Explorer"  onClick: launch("explorer.exe") }
            Text { text: "Keybindings"  onClick: kerys.settings() }
            Text { text: "close"  color: "foregroundMuted"  onClick: shell.close("launcher") }
        }
    }
}
