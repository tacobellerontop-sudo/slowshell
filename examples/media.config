// media.config — a transport bar for whatever is playing.
//
//     Shell.exe examples\media.config
//
// Shows:
//   * a bar with a live clock and a transport control
//   * media keys sent as real key events, not a private API
//   * the shape a media widget takes when nothing is playing
//
// The metadata is real. `media.title`, `media.artist`, `media.status` and
// `media.playing` come from SMTC's **global** session manager, which lists
// whatever every other process is publishing and needs no package identity.
//
// An earlier version of this file claimed that reading the current track was
// impossible without a UWP identity. That was true of the wrong door: the
// per-application `SystemMediaTransportControls.GetForCurrentView` does need one,
// and this is not it. `cargo run -p slowshell-win --example capability_probe`
// prints what the global manager actually returns on your machine.
//
// The watcher runs on a thread of its own, so SMTC's second-scale latency never
// reaches the frame loop. See crates/slowshell-win/src/media.rs.
//
// Sending the keys does work: `PlayPause` / `NextTrack` / `PrevTrack` are
// injected as real input, so whatever is playing responds to them.

Theme {
    radius: 10
    fontSize: 13
    accent: "#cba6f7"
    background: "#121019f2"
    surface: "#1e1b2bf7"
    foreground: "#edecee"
    foregroundMuted: "#a6a1b5"
    foregroundSubtle: "#6f6a7d"
    border: "#ffffff10"
}

Panel {
    position: "top"
    screen: "primary"
    height: 40
    background: "background"
    padding: 0

    left {
        Row {
            gap: 10
            padding: [0, 14]
            cross: "center"

            // The real track, when something is playing. `media.playing` is true
            // for both playing and paused, so a paused track keeps its controls
            // instead of vanishing.
            Container {
                visible: media.playing
                gap: 10
                cross: "center"

                Column {
                    gap: 0
                    Text { text: media.title  fontWeight: 600 }
                    Text { text: media.artist  color: "foregroundSubtle"  fontSize: 11 }
                }

                Text { text: "|<"  color: "foregroundMuted"  onClick: keys.send("PrevTrack") }
                Text {
                    // A paused track shows a play glyph, so the button always means
                    // "do the other thing".
                    text: media.status == "paused" ? ">|" : "||"
                    fontWeight: 700
                    padding: [4, 12]
                    radius: 6
                    background: "surface"
                    onClick: keys.send("PlayPause")
                }
                Text { text: ">|"  color: "foregroundMuted"  onClick: keys.send("NextTrack") }
            }

            // Shown only when nothing is. A bar with a hole in the middle looks
            // broken; a bar that says "nothing playing" looks deliberate.
            Row {
                visible: !media.playing
                cross: "center"
                Text { text: "Nothing playing"  color: "foregroundSubtle" }
            }
        }
    }

    center {
        Row {
            gap: 4
            cross: "center"

            // Transport. Each is a real key injection; `exec`-style side effects
            // do not need a privileged API for the standard media keys.
            Text {
                text: "<|"
                color: "foregroundMuted"
                padding: [4, 12]
                radius: 6
                onClick: keys.send("PrevTrack")
            }
            Text {
                text: ">||"
                color: "foreground"
                fontWeight: 700
                padding: [4, 12]
                radius: 6
                background: "surface"
                onClick: keys.send("PlayPause")
            }
            Text {
                text: ">|"
                color: "foregroundMuted"
                padding: [4, 12]
                radius: 6
                onClick: keys.send("NextTrack")
            }
        }
    }

    right {
        Row {
            gap: 14
            padding: [0, 14]
            cross: "center"

            // Volume. The shell cannot *read* the volume back without an audio
            // endpoint enumeration on a timer, so it does not pretend to: these
            // are write-only controls, and the config shows no gauge.
            Text { text: "vol -"  color: "foregroundMuted"  onClick: audio.lower() }
            Text { text: "vol +"  color: "foregroundMuted"  onClick: audio.raise() }
            Text { text: "mute"   color: "foregroundMuted"  onClick: audio.toggleMute() }

            Text { text: "|"  color: "border" }
            Clock { format: "HH:mm"  fontWeight: 600 }
        }
    }
}
