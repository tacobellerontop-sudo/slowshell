// minimal.config — the smallest thing that is still a desktop shell.
//
// One panel, one line of text. Use this to check that Slowshell runs at all:
//     Shell.exe examples\minimal.config
//
// Everything else in `examples/` is this file plus the parts being demonstrated.

Panel {
    position: "top"
    background: "#11111b"
    padding: 0

    center {
        Row {
            padding: [0, 16]
            Text { text: "Slowshell" }
        }
    }
}
