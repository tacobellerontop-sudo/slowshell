// dashboard.config — a floating status panel.
//
//     Shell.exe examples\dashboard.config
//
// Shows:
//   * a floating panel at an explicit position
//   * `Progress` widgets, and the two ways to name one (`value` or `progress`)
//   * a `container` used purely for grouping and styling
//   * opacity, which composites with its children
//   * the honest behaviour of a config that reads a provider which is not
//     implemented yet: `system.cpuUsage` is null here, and the widget says so
//     rather than showing a made-up number
//
// What is NOT shown: anything that would need polling. A CPU graph needs a
// sample every second or so, and a shell that samples on a timer spends the idle
// budget it exists to save. `system.cpuUsage` is wired to a value that only
// changes when something pushes it, so it reads 0 until that changes. When the
// provider lands it will push, and this config will animate with no edit.

Theme {
    radius: 14
    fontSize: 13
    accent: "#7c9cff"
    background: "#0d0f16f5"
    surface: "#181b25f7"
    surfaceAlt: "#22252fff"
    foreground: "#e6e7ef"
    foregroundMuted: "#8b8fa3"
    foregroundSubtle: "#5c6070"
    success: "#4ade80"
    warning: "#fbbf24"
    error: "#f87171"
    border: "#ffffff12"
}

Panel {
    position: "top"
    height: 32
    background: "background"
    padding: 0

    left {
        Row {
            gap: 14
            padding: [0, 14]
            cross: "center"
            Text {
                text: "Dashboard"
                fontWeight: 600
                color: "accent"
                onClick: shell.open("dashboard")
            }
        }
    }

    center {
        Row { Clock { format: "HH:mm"  color: "foregroundMuted" } }
    }

    right {
        Row {
            padding: [0, 14]
            Text { text: "examples/dashboard.config"  color: "foregroundSubtle"  fontSize: 11 }
        }
    }
}

// The dashboard itself. `hidden: true` means it has no window until the button
// above asks for one; run `shellctl open dashboard` to do the same from a
// terminal.
Panel {
    name: "dashboard"
    hidden: true
    position: "floating"
    width: 300
    height: 236
    anchorX: 0
    anchorY: 0
    background: "background"
    border: "border"
    borderWidth: 1
    radius: 14
    padding: 0

    content {
        Column {
            gap: 14
            padding: 16
            cross: "stretch"

            // ---- header ------------------------------------------------- //
            Row {
                cross: "center"
                Text { text: "System"  fontWeight: 600  fontSize: 15 }
                Spacer { width: 8 }
                Clock { format: "HH:mm"  color: "foregroundSubtle" }
            }

            // ---- bars ---------------------------------------------------- //
            // Each bar is a label, a spacer, and a `Progress`. The bar is a
            // child of a `container` so the group can be styled once.
            Container {
                gap: 6
                cross: "stretch"
                padding: 10
                background: "surface"
                radius: 8

                Text { text: "CPU"  color: "foregroundMuted" }
                Progress { value: system.cpuUsage / 100  height: 6  color: "accent"  radius: 3 }

                Text { text: "Memory"  color: "foregroundMuted"  padding: [0, 4] }
                Progress { value: system.memoryUsage / 100  height: 6  color: "success"  radius: 3 }
            }

            Container {
                gap: 6
                cross: "stretch"
                padding: 10
                background: "surface"
                radius: 8

                Text { text: "Displays"  color: "foregroundMuted" }
                Row {
                    gap: 8
                    // `screens.count` is real on this machine, so this row is
                    // populated rather than showing a placeholder.
                    Text { text: screens.count }
                    Text { text: "attached"  color: "foregroundMuted" }
                }
            }

            // ---- actions ------------------------------------------------ //
            Row {
                gap: 8
                cross: "center"

                Text {
                    text: "reload"
                    padding: [6, 12]
                    background: "surfaceAlt"
                    radius: 7
                    color: "foreground"
                    onClick: shell.reload()
                }
                Text {
                    text: "hide overlay"
                    padding: [6, 12]
                    background: "surfaceAlt"
                    radius: 7
                    color: "foregroundMuted"
                    onClick: shell.overlay()
                }
            }
        }
    }
}
