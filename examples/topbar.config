// topbar.config — a complete, working top bar.
//
//     Shell.exe examples\topbar.config
//
// Shows:
//   * the three panel bands, `left` / `center` / `right`
//   * a live clock in the centre
//   * a themed palette via a `Theme` block
//   * click handlers that do something real
//   * a floating popup panel that starts hidden and is opened on demand
//
// A note on the system paths. `battery`, `network` and the rest read as `null`
// where the provider is not implemented on your machine, and `null + "%"`
// renders as the string "null%". So nothing here prints a raw provider value
// unguarded: every one is behind a `visible` check or a comparison. Run
// `shellctl doctor` to see which providers are live on your machine.

Theme {
    name: "topbar"
    dark: true
    radius: 8
    fontSize: 13
    accent: "#8b5cf6"
    background: "#0f1117f2"
    surface: "#1a1d27f5"
    foreground: "#e6e7ef"
    foregroundMuted: "#8b8fa3"
    success: "#4ade80"
    warning: "#fbbf24"
    error: "#f87171"
}

Panel {
    position: "top"
    screen: "primary"
    exclusive: true
    background: "background"
    height: 32
    padding: 0

    // ---------------------------------------------------------------- left --
    left {
        Row {
            gap: 8
            padding: [0, 12]
            cross: "center"

            // Opens the hidden popup panel declared at the bottom of this file.
            Text {
                text: "Apps"
                fontWeight: 600
                onClick: shell.open("launcher")
            }

            Text { text: "|"  color: "borderStrong" }
            Text { text: "1"  fontWeight: 600 }
            Text { text: "2"  color: "foregroundSubtle" }
            Text { text: "3"  color: "foregroundSubtle" }
        }
    }

    // -------------------------------------------------------------- centre --
    center {
        Row {
            cross: "center"
            Clock { format: "HH:mm"  fontWeight: 500 }
        }
    }

    // --------------------------------------------------------------- right --
    right {
        Row {
            gap: 16
            padding: [0, 12]
            cross: "center"

            // Battery: two widgets, each visible under one condition. A desktop
            // with no battery shows neither, which is better than a permanent 0%.
            Text {
                text: battery.percentage + "%"
                color: "foregroundMuted"
                visible: battery.present
            }
            Text {
                text: "battery low"
                color: "error"
                fontWeight: 600
                visible: battery.present && battery.percentage < 20
            }

            // Network.
            Text {
                text: "WiFi"
                color: "foregroundMuted"
                visible: network.connected
            }
            Text {
                text: "offline"
                color: "warning"
                visible: !network.connected
            }

            // A second clock, different format. Each `Clock` is its own element,
            // so two of them cost nothing extra.
            Clock { format: "D MMM"  color: "foregroundMuted" }

            // Toggles the developer error overlay, which is also
            // `shellctl overlay` from a terminal.
            Text {
                text: "shell"
                color: "foregroundMuted"
                onClick: shell.overlay()
            }
        }
    }
}

// -------------------------------------------------------------------------- //
// The launcher.
//
// This is a Panel like any other. `shell.open("launcher")` builds it on demand,
// so the config file is the only description of the desktop and the renderer
// learns no new concept for a launcher.
//
// `position: "top"` plus explicit `width`/`height`/`anchorX` makes it a
// floating window centred along the top edge.
// -------------------------------------------------------------------------- //

Panel {
    name: "launcher"
    hidden: true
    position: "top"
    width: 520
    height: 46
    anchorX: 0.5
    background: "surface"
    border: "borderStrong"
    borderWidth: 1
    radius: 12
    padding: 0

    content {
        Row {
            gap: 14
            padding: [0, 16]
            cross: "center"

            Text { text: "Run"  color: "foregroundSubtle" }
            Text { text: "notepad.exe"  color: "foreground" }
            Text {
                text: "launch"
                color: "accent"
                fontWeight: 600
                onClick: launch("notepad.exe")
            }
        }
    }
}
