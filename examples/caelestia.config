// caelestia.config — hover the screen edges to open menus, like Caelestia Shell.
//
//     cargo shell -- examples\caelestia.config
//
// The bar is the top strip. The two vertical panels are collapsed to 8px strips
// against the left and right edges; move the pointer onto either and it opens
// into a menu, then closes again a moment after you leave.
//
// Three properties make this work, and each is a separate thing:
//
//   reveal: true        open on hover rather than always being open
//   revealSize: 8       the width of the collapsed strip, which is what you hover
//   revealDelay: 260    ms to wait after the pointer leaves before closing
//
// `revealDelay` is the one that is not cosmetic. Without it, moving the pointer
// diagonally out of a panel that is still opening closes it mid-flight, and the
// far side of your own menu is unreachable. 260ms is enough to cross an opening
// panel and not enough to feel like the menu is stuck.
//
// `revealDuration` and `revealEase` control the movement. The default is 180ms on
// `outCubic`, which spends most of the movement early and settles at the end — that
// is what makes it feel responsive rather than slow. Try `revealEase: "outBack"`
// for a slight overshoot, which is more physical and more noticeable.

Theme {
    radius: 12
    fontSize: 13
    accent: "#7c9cff"
    background: "#151821f5"
    surface: "#242a3cf7"
    foreground: "#e8eaf2"
    foregroundMuted: "#8f95ab"
    foregroundSubtle: "#5d6479"
    border: "#ffffff14"
    danger: "#ff6b81"
}

// ===========================================================================
// The bar
// ===========================================================================

Panel {
    position: "top"
    screen: "primary"
    exclusive: true
    height: 44
    background: "background"
    padding: 0

    left {
        Row {
            gap: 10
            padding: [0, 14]
            cross: "center"
            Text { text: "caelestia-style"  fontWeight: 700  color: "accent" }
            Text { text: "hover a side"  color: "foregroundSubtle" }
        }
    }

    center {
        Row {
            cross: "center"
            gap: 8
            // The two edge menus open these. `shell.open` builds a hidden panel on
            // demand, so this costs nothing until it is used.
            Text {
                text: "apps"
                padding: [5, 12]
                radius: 8
                background: "surface"
                onClick: shell.open("apps")
            }
            Text {
                text: "settings"
                padding: [5, 12]
                radius: 8
                onClick: shell.open("settings")
            }
        }
    }

    right {
        Row {
            gap: 14
            padding: [0, 14]
            cross: "center"
            Text { text: windows.active.title  color: "foregroundMuted"  visible: windows.active.title != "" }
            Text { text: "|"  color: "border" }
            Clock { format: "HH:mm"  fontWeight: 600 }
        }
    }
}

// ===========================================================================
// The left edge menu
// ===========================================================================
//
// `width` is how wide it is when open; `revealSize` is how wide it is closed. The
// panel starts at the strip, so there is always something to hover.

Panel {
    position: "left"
    screen: "primary"

    reveal: true
    revealSize: 8
    revealDuration: 180
    revealDelay: 260
    revealEase: "outCubic"

    width: 210
    background: "background"
    radius: 0
    padding: 0

    left {
        Column {
            gap: 6
            padding: 12
            radius: 14
            border: "border"
            borderWidth: 1

            Text { text: "Applications"  fontWeight: 700  color: "foregroundMuted"  fontSize: 11  padding: [0, 4, 4, 4] }

            Text { text: "Terminal"        padding: [8, 12]  radius: 8  background: "surface"  onClick: launch("wt") }
            Text { text: "Notepad"         padding: [8, 12]  radius: 8  background: "surface"  onClick: launch("notepad") }
            Text { text: "File Explorer"   padding: [8, 12]  radius: 8  background: "surface"  onClick: launch("explorer") }
            Text { text: "Edge"            padding: [8, 12]  radius: 8  background: "surface"  onClick: launch("msedge") }
            Text { text: "Settings"        padding: [8, 12]  radius: 8  background: "surface"  onClick: launch("ms-settings:") }
        }
    }
}

// ===========================================================================
// The right edge menu
// ===========================================================================
//
// `outBack` overshoots slightly on the way open. On a 210px panel that is a few
// pixels past its final width and back, which reads as weight — the thing people
// mean when they say an animation has weight.

Panel {
    position: "right"
    screen: "primary"

    reveal: true
    revealSize: 8
    revealDuration: 200
    revealDelay: 260
    revealEase: "outBack"

    width: 230
    background: "background"
    radius: 0
    padding: 0

    right {
        Column {
            gap: 6
            padding: 12
            radius: 14
            border: "border"
            borderWidth: 1

            Text { text: "System"  fontWeight: 700  color: "foregroundMuted"  fontSize: 11  padding: [0, 4, 4, 4] }

            // Real values. Battery is hidden on a machine without one, because a
            // desktop showing 0% is worse than a desktop showing nothing.
            Row {
                visible: battery.present
                gap: 8
                padding: [8, 12]
                radius: 8
                background: "surface"
                Text { text: "Battery"  color: "foregroundMuted" }
                Spacer {}
                Text { text: battery.percentage + "%"  fontWeight: 600 }
            }

            Row {
                gap: 8
                padding: [8, 12]
                radius: 8
                background: "surface"
                Text { text: "Network"  color: "foregroundMuted" }
                Spacer {}
                Text { text: network.connected ? "online" : "offline"  fontWeight: 600  color: network.connected ? "accent" : "foregroundSubtle" }
            }

            Row {
                gap: 8
                padding: [8, 12]
                radius: 8
                background: "surface"
                Text { text: "Volume"  color: "foregroundMuted" }
                Spacer {}
                Text { text: "-"  onClick: audio.lower() }
                Text { text: "+"  onClick: audio.raise() }
            }

            Text { text: "Power"  fontWeight: 700  color: "foregroundMuted"  fontSize: 11  padding: [4, 4, 4, 4] }

            Text { text: "Lock"          padding: [8, 12]  radius: 8  background: "surface"  onClick: windows.lock() }
            Text { text: "Show desktop"  padding: [8, 12]  radius: 8  background: "surface"  onClick: windows.minimiseAll() }
            Text { text: "Sign out"       padding: [8, 12]  radius: 8  background: "surface"  onClick: windows.lock() }
            Text {
                text: "Restart"
                color: "danger"
                padding: [8, 12]
                radius: 8
                background: "surface"
                onClick: system.restart()
            }
        }
    }
}

// ===========================================================================
// The two menus the bar's centre buttons open
// ===========================================================================
//
// Declared hidden, so they cost nothing until asked for. A hidden panel has no
// window, which is also why a hidden panel cannot `reveal`: there is nothing to
// hover.

Panel {
    name: "apps"
    hidden: true
    position: "top"
    screen: "primary"
    height: 300
    backdrop: "acrylic"
    background: "#151821f7"
    radius: 14
    padding: 14

    center {
        Column {
            gap: 8
            Text { text: "Applications"  fontWeight: 700  padding: [0, 4] }
            Text { text: "Terminal"       padding: [9, 12]  radius: 8  background: "surface"  onClick: launch("wt") }
            Text { text: "Notepad"        padding: [9, 12]  radius: 8  background: "surface"  onClick: launch("notepad") }
            Text { text: "File Explorer"  padding: [9, 12]  radius: 8  background: "surface"  onClick: launch("explorer") }
        }
    }
}

Panel {
    name: "settings"
    hidden: true
    position: "top"
    screen: "primary"
    height: 180
    backdrop: "acrylic"
    background: "#151821f7"
    radius: 14
    padding: 14

    center {
        Column {
            gap: 8
            Text { text: "Shell"  fontWeight: 700  padding: [0, 4] }
            Text { text: "Reload config"  padding: [9, 12]  radius: 8  background: "surface"  onClick: shell.reload() }
            Text { text: "Copy config path"  padding: [9, 12]  radius: 8  background: "surface"  onClick: clipboard.set("C:\\Users\\me\\AppData\\Roaming\\Slowshell\\shell.config") }
            Text { text: "Quit"  padding: [9, 12]  radius: 8  background: "surface"  color: "danger"  onClick: shell.stop() }
        }
    }
}
