// caelestia.config — Caelestia Shell, recreated for Windows.
//
//     Shell.exe examples\caelestia.config
//
// Caelestia (github.com/caelestia-dots/shell) is a Quickshell desktop for
// Hyprland. This is the same layout, built from Slowshell panels:
//
//   * a vertical bar on the left edge: logo, workspaces, binding mode, clock,
//     status icons and a power button
//   * a thin rounded frame around the whole screen (`wrap`)
//   * drawers that slide out of that frame when you hover its edges:
//
//         ┌──────────────[ dashboard ]──────────────┬
//         │                                         │
//         B                                    [ osd ]
//         A                                         │
//         R                                 [ session ]
//         │                                         │
//         └──────────────[ launcher ]────[ utilities ]
//
//     top centre      dashboard: date and time, media, CPU / memory / battery
//     bottom centre   launcher: apps and Kerys keybindings
//     right, upper    OSD: volume and mute
//     right, middle   session: lock, sign out, sleep, restart, shut down
//     bottom right    utilities: quick toggles
//
// Each drawer is a `reveal` panel: collapsed to a strip as thick as the frame,
// so it is invisible until you touch the edge, then it grows out of the frame and
// closes again a moment after you leave. `anchorX` / `anchorY` say where along
// the edge it hangs.
//
// Icons are Segoe Fluent Icons, the Windows 11 icon font, standing in for the
// Material Symbols Caelestia uses. Workspaces call `rwm` (rustWM's CLI); with
// another window manager, change those `exec.run` lines.
//
// Not recreated, because Slowshell cannot do it yet: popouts when hovering a
// bar icon, the notification centre and its sidebar, the calendar and weather
// cards, the audio visualiser, the wallpaper picker and the lock screen.
// Caelestia's drag-to-open on the session drawer is hover-to-open here.

// The default Caelestia scheme (Material 3, dark, from its Colours.qml).
Theme {
    name: "caelestia"
    dark: true
    radius: 16
    fontSize: 13

    background: "#191114"         // m3surface
    surface: "#261d20"            // m3surfaceContainer
    surfaceAlt: "#31282a"         // m3surfaceContainerHigh
    foreground: "#efdfe2"         // m3onSurface
    foregroundMuted: "#d5c2c6"    // m3onSurfaceVariant
    foregroundSubtle: "#9e8c91"   // m3outline
    accent: "#ffb0ca"             // m3primary
    accentHover: "#ffd9e3"        // m3primaryFixed
    accentPressed: "#e2bdc7"      // m3secondary
    success: "#b5ccba"
    warning: "#f0bc95"            // m3tertiary
    error: "#ffb4ab"
    border: "#514347"             // m3outlineVariant
    borderStrong: "#9e8c91"
}

// ===========================================================================
// The bar, and the frame around the screen
// ===========================================================================

Panel {
    position: "left"
    exclusive: true
    width: 52
    background: "background"
    padding: 0
    radius: 0

    // The frame. `wrap` continues the bar's background round the other three
    // edges and reserves them, so windows sit inside a rounded border exactly
    // as they do in Caelestia (`border.thickness: 10`).
    wrap: true
    wrapSize: 10

    // ---- top: logo and workspaces --------------------------------------
    left {
        Column {
            gap: 6
            padding: [14, 0]
            cross: "center"

            // The OS icon. Caelestia shows the distro logo; this opens the launcher.
            Text {
                text: "\u{2756}"
                fontSize: 22
                color: "accent"
                padding: [2, 0, 10, 0]
                onClick: shell.toggle("apps")
            }

            // Workspaces, as Caelestia's pills. rustWM owns workspaces; `rwm` is its CLI.
            Column {
                gap: 4
                padding: [6, 4]
                radius: 14
                background: "surface"
                cross: "center"
                Text { text: "1"  fontWeight: 700  color: "#541d34"  background: "accent"  radius: 10  padding: [4, 9]  onClick: exec.run("rwm", ["workspace", "1"]) }
                Text { text: "2"  color: "foregroundMuted"  padding: [4, 9]  onClick: exec.run("rwm", ["workspace", "2"]) }
                Text { text: "3"  color: "foregroundMuted"  padding: [4, 9]  onClick: exec.run("rwm", ["workspace", "3"]) }
                Text { text: "4"  color: "foregroundSubtle"  padding: [4, 9]  onClick: exec.run("rwm", ["workspace", "4"]) }
                Text { text: "5"  color: "foregroundSubtle"  padding: [4, 9]  onClick: exec.run("rwm", ["workspace", "5"]) }
            }

            // The Kerys binding mode, like a Hyprland submap: only there while a
            // mode such as "resize" is on.
            Text {
                text: kerys.mode
                fontSize: 10
                fontWeight: 700
                color: "#48290c"
                background: "warning"
                radius: 8
                padding: [3, 5]
                visible: kerys.running && kerys.mode != "default"
            }
        }
    }

    // ---- bottom: clock, status icons, power ------------------------------
    right {
        Column {
            gap: 10
            padding: [14, 0]
            cross: "center"

            // Caelestia stacks the clock vertically: hours over minutes.
            Column {
                gap: 0
                cross: "center"
                Text { text: "\u{E917}"  fontFamily: "Segoe Fluent Icons"  fontSize: 14  color: "accent"  padding: [0, 0, 4, 0] }
                Clock { format: "HH"  fontWeight: 600  color: "accent" }
                Clock { format: "mm"  fontWeight: 600  color: "accent" }
            }

            // Status icons, in one rounded group.
            Column {
                gap: 10
                padding: [10, 8]
                radius: 14
                background: "surface"
                cross: "center"
                Text {
                    text: audio.muted ? "\u{E74F}" : "\u{E767}"
                    fontFamily: "Segoe Fluent Icons"
                    fontSize: 15
                    visible: audio.available
                    onClick: audio.toggleMute()
                }
                Text {
                    text: "\u{E701}"
                    fontFamily: "Segoe Fluent Icons"
                    fontSize: 15
                    color: network.connected ? "foreground" : "foregroundSubtle"
                }
                Text {
                    text: battery.charging ? "\u{E83E}" : "\u{E83F}"
                    fontFamily: "Segoe Fluent Icons"
                    fontSize: 15
                    color: battery.percentage < 20 && !battery.plugged ? "error" : "foreground"
                    visible: battery.present
                }
                Text {
                    text: "\u{E765}"
                    fontFamily: "Segoe Fluent Icons"
                    fontSize: 15
                    color: kerys.running ? "foreground" : "foregroundSubtle"
                    onClick: kerys.toggle()
                }
            }

            // The power button opens the session menu, as Caelestia's does.
            Text {
                text: "\u{E7E8}"
                fontFamily: "Segoe Fluent Icons"
                fontSize: 17
                color: "error"
                padding: [4, 0]
                onClick: shell.toggle("power")
            }
        }
    }
}

// ===========================================================================
// Dashboard: hover the top centre of the screen
// ===========================================================================

Panel {
    position: "top"
    anchorX: 0.5
    width: 680
    height: 250

    reveal: true
    revealSize: 10
    revealDuration: 260
    revealDelay: 300
    revealEase: "outBack"

    background: "background"
    radius: 0
    padding: 0

    content {
        Row {
            gap: 12
            padding: [12, 16, 16, 16]
            cross: "stretch"
            justify: "center"

            // Date and time, large, as Caelestia's DateTime card.
            Column {
                gap: 2
                padding: [16, 18]
                radius: 16
                background: "surface"
                cross: "center"
                justify: "center"
                minWidth: 150
                Clock { format: "HH:mm"  fontSize: 40  fontWeight: 600  color: "accent" }
                Clock { format: "dddd"  fontSize: 14  color: "foregroundMuted" }
                Clock { format: "d MMMM yyyy"  fontSize: 12  color: "foregroundSubtle" }
            }

            // Now playing.
            Column {
                gap: 6
                padding: [14, 16]
                radius: 16
                background: "surface"
                cross: "start"
                minWidth: 200
                Text { text: "NOW PLAYING"  fontSize: 10  fontWeight: 700  letterSpacing: 1.2  color: "foregroundSubtle" }
                Text { text: media.title != "" ? media.title : "Nothing playing"  fontSize: 15  fontWeight: 600 }
                Text { text: media.artist  color: "foregroundMuted"  visible: media.artist != "" }
                Spacer {}
                Row {
                    gap: 18
                    cross: "center"
                    Text { text: "\u{E72B}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  onClick: keys.send("PrevTrack") }
                    Text {
                        text: media.playing ? "\u{E769}" : "\u{E768}"
                        fontFamily: "Segoe Fluent Icons"
                        fontSize: 18
                        color: "#541d34"
                        background: "accent"
                        radius: 14
                        padding: [6, 10]
                        onClick: keys.send("PlayPause")
                    }
                    Text { text: "\u{E72A}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  onClick: keys.send("NextTrack") }
                }
            }

            // Resources, as Caelestia's Resources card.
            Column {
                gap: 8
                padding: [14, 16]
                radius: 16
                background: "surface"
                cross: "stretch"
                minWidth: 170
                Text { text: "RESOURCES"  fontSize: 10  fontWeight: 700  letterSpacing: 1.2  color: "foregroundSubtle" }
                Row {
                    gap: 8
                    Text { text: "\u{EEA1}"  fontFamily: "Segoe Fluent Icons"  color: "accent" }
                    Text { text: "CPU"  color: "foregroundMuted" }
                    Spacer {}
                    Text { text: system.cpuUsage + "%"  fontWeight: 600 }
                }
                Progress { value: system.cpuUsage / 100  height: 6  radius: 3  color: "accent"  background: "surfaceAlt" }
                Row {
                    gap: 8
                    Text { text: "\u{EEA0}"  fontFamily: "Segoe Fluent Icons"  color: "warning" }
                    Text { text: "Memory"  color: "foregroundMuted" }
                    Spacer {}
                    Text { text: system.memoryUsage + "%"  fontWeight: 600 }
                }
                Progress { value: system.memoryUsage / 100  height: 6  radius: 3  color: "warning"  background: "surfaceAlt" }
                Row {
                    gap: 8
                    visible: battery.present
                    Text { text: "\u{E83F}"  fontFamily: "Segoe Fluent Icons"  color: "success" }
                    Text { text: battery.charging ? "Charging" : "Battery"  color: "foregroundMuted" }
                    Spacer {}
                    Text { text: battery.percentage + "%"  fontWeight: 600 }
                }
                Progress { visible: battery.present  value: battery.percentage / 100  height: 6  radius: 3  color: "success"  background: "surfaceAlt" }
            }
        }
    }
}

// ===========================================================================
// Launcher: hover the bottom centre of the screen
// ===========================================================================

Panel {
    position: "bottom"
    anchorX: 0.5
    width: 560
    height: 260

    reveal: true
    revealSize: 10
    revealDuration: 240
    revealDelay: 300
    revealEase: "outCubic"

    background: "background"
    radius: 0
    padding: 0

    content {
        Column {
            gap: 6
            padding: [16, 16, 12, 16]
            cross: "stretch"

            Row {
                gap: 10
                padding: [10, 14]
                radius: 22
                background: "surface"
                cross: "center"
                Text { text: "\u{E721}"  fontFamily: "Segoe Fluent Icons"  color: "foregroundMuted" }
                Text { text: "Apps"  color: "foregroundSubtle" }
            }

            Row {
                gap: 12
                padding: [8, 14]
                radius: 12
                background: "surfaceAlt"
                cross: "center"
                onClick: launch("wt")
                Text { text: "\u{E756}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  color: "accent" }
                Text { text: "Terminal"  fontWeight: 600 }
                Spacer {}
                Text { text: "wt"  color: "foregroundSubtle" }
            }
            Row {
                gap: 12
                padding: [8, 14]
                radius: 12
                cross: "center"
                onClick: launch("explorer")
                Text { text: "\u{E838}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  color: "accent" }
                Text { text: "Files" }
                Spacer {}
                Text { text: "explorer"  color: "foregroundSubtle" }
            }
            Row {
                gap: 12
                padding: [8, 14]
                radius: 12
                cross: "center"
                onClick: launch("msedge")
                Text { text: "\u{E774}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  color: "accent" }
                Text { text: "Browser" }
                Spacer {}
                Text { text: "msedge"  color: "foregroundSubtle" }
            }
            Row {
                gap: 12
                padding: [8, 14]
                radius: 12
                cross: "center"
                onClick: kerys.settings()
                Text { text: "\u{E765}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  color: "accent" }
                Text { text: "Keybindings" }
                Spacer {}
                Text { text: "kerys"  color: "foregroundSubtle" }
            }
            Row {
                gap: 12
                padding: [8, 14]
                radius: 12
                cross: "center"
                onClick: launch("ms-settings:")
                Text { text: "\u{E713}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  color: "accent" }
                Text { text: "Settings" }
                Spacer {}
                Text { text: "ms-settings"  color: "foregroundSubtle" }
            }
        }
    }
}

// ===========================================================================
// OSD: hover the right edge, upper half
// ===========================================================================

Panel {
    position: "right"
    anchorY: 0.3
    width: 64
    height: 200

    reveal: true
    revealSize: 10
    revealDuration: 200
    revealDelay: 400
    revealEase: "outCubic"

    background: "background"
    radius: 0
    padding: 0

    content {
        Column {
            gap: 10
            padding: [14, 10]
            cross: "center"
            Text { text: "\u{E70E}"  fontFamily: "Segoe Fluent Icons"  fontSize: 14  padding: [4, 8]  radius: 10  background: "surface"  onClick: audio.raise() }
            Text { text: audio.volume + ""  fontWeight: 700  color: audio.muted ? "foregroundSubtle" : "accent" }
            Text { text: "\u{E70D}"  fontFamily: "Segoe Fluent Icons"  fontSize: 14  padding: [4, 8]  radius: 10  background: "surface"  onClick: audio.lower() }
            Text {
                text: audio.muted ? "\u{E74F}" : "\u{E767}"
                fontFamily: "Segoe Fluent Icons"
                fontSize: 16
                color: audio.muted ? "error" : "foreground"
                onClick: audio.toggleMute()
            }
        }
    }
}

// ===========================================================================
// Session: hover the right edge, middle
// ===========================================================================

Panel {
    position: "right"
    anchorY: 0.62
    width: 80
    height: 300

    reveal: true
    revealSize: 10
    revealDuration: 240
    revealDelay: 350
    revealEase: "outBack"

    background: "background"
    radius: 0
    padding: 0

    content {
        Column {
            gap: 12
            padding: [16, 12]
            cross: "center"
            Text { text: "\u{E72E}"  fontFamily: "Segoe Fluent Icons"  fontSize: 22  padding: [12, 14]  radius: 18  background: "surface"  onClick: windows.lock() }
            Text { text: "\u{E8AC}"  fontFamily: "Segoe Fluent Icons"  fontSize: 22  padding: [12, 14]  radius: 18  background: "surface"  onClick: exec.run("shutdown", ["/l"]) }
            Text { text: "\u{E708}"  fontFamily: "Segoe Fluent Icons"  fontSize: 22  padding: [12, 14]  radius: 18  background: "surface"  onClick: exec.run("rundll32.exe", ["powrprof.dll,SetSuspendState", "0,1,0"]) }
            Text { text: "\u{E72C}"  fontFamily: "Segoe Fluent Icons"  fontSize: 22  padding: [12, 14]  radius: 18  background: "surface"  onClick: system.restart() }
            Text { text: "\u{E7E8}"  fontFamily: "Segoe Fluent Icons"  fontSize: 22  padding: [12, 14]  radius: 18  color: "#690005"  background: "error"  onClick: system.shutdown() }
        }
    }
}

// ===========================================================================
// Utilities: hover the bottom right corner
// ===========================================================================

Panel {
    position: "bottom"
    // Just short of the corner, so the drawer sits inside the frame's right arm
    // rather than underneath it.
    anchorX: 0.99
    width: 300
    height: 170

    reveal: true
    revealSize: 10
    revealDuration: 220
    revealDelay: 300
    revealEase: "outCubic"

    background: "background"
    radius: 0
    padding: 0

    content {
        Column {
            gap: 10
            padding: [14, 16]
            cross: "stretch"
            Text { text: "Quick toggles"  fontWeight: 600 }
            Row {
                gap: 8
                cross: "center"
                Text { text: "\u{E765}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  padding: [10, 12]  radius: 14  background: kerys.running ? "accent" : "surface"  color: kerys.running ? "#541d34" : "foreground"  onClick: kerys.toggle() }
                Text { text: "\u{E74F}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  padding: [10, 12]  radius: 14  background: audio.muted ? "accent" : "surface"  color: audio.muted ? "#541d34" : "foreground"  onClick: audio.toggleMute() }
                Text { text: "\u{E722}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  padding: [10, 12]  radius: 14  background: "surface"  onClick: launch("ms-screenclip:") }
                Text { text: "\u{E713}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  padding: [10, 12]  radius: 14  background: "surface"  onClick: launch("ms-settings:") }
                Text { text: "\u{E72C}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  padding: [10, 12]  radius: 14  background: "surface"  onClick: shell.reload() }
            }
            Row {
                gap: 8
                cross: "center"
                Text { text: "keys"  fontSize: 11  color: "foregroundSubtle" }
                Text { text: "mute"  fontSize: 11  color: "foregroundSubtle" }
                Text { text: "snip"  fontSize: 11  color: "foregroundSubtle" }
                Text { text: "settings"  fontSize: 11  color: "foregroundSubtle" }
                Text { text: "reload"  fontSize: 11  color: "foregroundSubtle" }
            }
        }
    }
}

// ===========================================================================
// Opened by clicks rather than hover
// ===========================================================================

// The power button's session menu, centred on screen.
Panel {
    name: "power"
    hidden: true
    position: "floating"
    width: 420
    height: 120
    background: "background"
    border: "border"
    borderWidth: 1
    radius: 24
    padding: 0

    content {
        Row {
            gap: 12
            padding: 20
            cross: "center"
            justify: "center"
            Text { text: "\u{E72E}"  fontFamily: "Segoe Fluent Icons"  fontSize: 24  padding: [16, 18]  radius: 20  background: "surface"  onClick: windows.lock() }
            Text { text: "\u{E8AC}"  fontFamily: "Segoe Fluent Icons"  fontSize: 24  padding: [16, 18]  radius: 20  background: "surface"  onClick: exec.run("shutdown", ["/l"]) }
            Text { text: "\u{E72C}"  fontFamily: "Segoe Fluent Icons"  fontSize: 24  padding: [16, 18]  radius: 20  background: "surface"  onClick: system.restart() }
            Text { text: "\u{E7E8}"  fontFamily: "Segoe Fluent Icons"  fontSize: 24  padding: [16, 18]  radius: 20  color: "#690005"  background: "error"  onClick: system.shutdown() }
            Text { text: "\u{E711}"  fontFamily: "Segoe Fluent Icons"  fontSize: 16  color: "foregroundSubtle"  onClick: shell.close("power") }
        }
    }
}

// The logo's app list, for when you would rather click than hover.
Panel {
    name: "apps"
    hidden: true
    position: "floating"
    width: 360
    height: 220
    background: "background"
    border: "border"
    borderWidth: 1
    radius: 24
    padding: 0

    content {
        Column {
            gap: 6
            padding: 16
            cross: "stretch"
            Text { text: "Apps"  fontWeight: 700  padding: [0, 4, 4, 4] }
            Text { text: "Terminal"  padding: [8, 12]  radius: 12  background: "surface"  onClick: launch("wt") }
            Text { text: "Files"     padding: [8, 12]  radius: 12  background: "surface"  onClick: launch("explorer") }
            Text { text: "Browser"   padding: [8, 12]  radius: 12  background: "surface"  onClick: launch("msedge") }
            Text { text: "Close"  color: "foregroundSubtle"  padding: [4, 12]  onClick: shell.close("apps") }
        }
    }
}
