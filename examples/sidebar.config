// sidebar.config — a vertical dock along the left edge.
//
//     Shell.exe examples\sidebar.config
//
// Shows:
//   * a `left` panel, and how a vertical panel sizes itself from its content
//   * `exclusive: true` so windows are pushed aside rather than covered
//   * a `Column` of rows, each row an icon-ish label
//   * `letterSpacing` for small-caps-style section headers
//   * the `accent` token used for the active item

Theme {
    radius: 10
    fontSize: 13
    accent: "#7c9cff"
    background: "#14161fd9"
    surface: "#1d202bee"
    foreground: "#e6e7ef"
    foregroundMuted: "#9a9db0"
}

Panel {
    position: "left"
    screen: "primary"
    exclusive: true
    background: "background"
    padding: 0

    center {
        Column {
            gap: 2
            padding: [10, 8]
            cross: "stretch"

            // A section header. `letterSpacing` is what turns a plain string
            // into something that reads as a label rather than as a word.
            Text {
                text: "DESKTOP"
                color: "foregroundSubtle"
                fontSize: 10
                fontWeight: 700
                letterSpacing: 1.2
                padding: [0, 6, 8, 6]
            }

            Text { text: "Terminal"  padding: [6, 10]  borderRadius: 6 }
            Text { text: "Editor"    padding: [6, 10]  borderRadius: 6 }
            Text { text: "Files"     padding: [6, 10]  borderRadius: 6  color: "foregroundMuted" }

            // The active item. An accent stripe reads as "selected" without
            // needing a separate selected-state property to exist and rot.
            Row {
                gap: 8
                padding: [6, 10]
                cross: "center"
                Text { text: "Browser"  fontWeight: 600 }
            }

            Spacer { }

            Text {
                text: "Settings"
                color: "foregroundMuted"
                padding: [6, 10]
                borderRadius: 6
            }
        }
    }
}
