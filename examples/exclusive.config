// exclusive.config — reserving screen space, the way a taskbar does.
//
//     Shell.exe examples\exclusive.config
//
// `exclusive: true` makes maximised windows stop at this bar instead of covering
// it, which is what `minimal.config` does not do. Watch it work: open Notepad and
// press Win+Up. Its top edge lands exactly below the bar. Close the shell and
// maximise again — the space comes back, because the bar is released when its
// window is destroyed rather than left behind in the registry.
//
// `shellctl screens` reports what the OS thinks, and it is the honest answer:
//
//     primary   1920x1080  @1.0  origin 0,0  60Hz  primary
//              work area 0,48 1920x984          <- was 1920x1032
//     reserved by slowshell
//       panel          top          0,0     1920x48
//
// The work area drops by exactly the bar's height. Compare that with the taskbar
// already taking its own strip: both are counted, and they do not overlap.

Panel {
    position: "top"
    screen: "primary"

    // The one property that matters here. Without it this is just a bar drawn
    // over the desktop, and maximised windows pass straight through it.
    exclusive: true

    height: 48
    background: "#11111b"
    padding: 0

    left {
        Row {
            padding: [0, 16]
            cross: "center"
            gap: 12
            Text { text: "exclusive"  fontWeight: 700 }
            Text { text: "space reserved"  color: "foregroundMuted" }
        }
    }

    center {
        Row {
            cross: "center"
            // The bar's height comes from its content, so this is what tells
            // Windows how much to reserve. Change it and the work area follows
            // after the next `shellctl reload`.
            Clock { format: "HH:mm" }
        }
    }

    right {
        Row {
            padding: [0, 16]
            cross: "center"
            // Prove it: maximise a window and it stops here, not under the bar.
            Text { text: "maximize something"  color: "foregroundMuted" }
        }
    }
}

// Two things worth trying in this file:
//
// 1. Change `position` to "bottom" and reload. On a machine whose taskbar is
//    also at the bottom, the two stack rather than overlapping, because an
//    exclusive panel is placed against the work area and the work area already
//    excludes the taskbar. Move it back to "top" if you prefer.
//
// 2. Add a second Panel with `position: "bottom"` and `exclusive: true`. It
//    claims the strip below the first one, and the work area shrinks by both.
//    Two bars, one edge, no overlap.
//
// A `floating` panel reserves nothing, so `exclusive` is ignored there. That is
// what makes it an overlay rather than a bar.
