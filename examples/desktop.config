// desktop.config — the one to actually use.
//
//     cargo shell -- examples\desktop.config
//
// Everything here reads a real source. There is no placeholder standing in for a
// value the shell cannot actually read, and where Windows offers no way to get
// something, the file says so rather than showing a number that never changes.
//
// What is on the bar:
//   * now playing, with working transport controls   (SMTC, the global manager)
//   * the active window's title                       (foreground window)
//   * battery, network, volume                        (real reads)
//   * clock and date
//   * a launcher, a terminal, and a power menu
//   * the background continues around every edge      (`wrap: true`)
//
// Two things are deliberately absent. Both are explained where they would go.

// -- Theme ------------------------------------------------------------------
// `background` is what the wrap arms paint too, so it has to be the colour you
// want the frame to be, not just the colour behind the text.
Theme {
    radius: 10
    fontSize: 13
    accent: "#7c9cff"
    background: "#151821f2"
    surface: "#222738f7"
    foreground: "#e8eaf2"
    foregroundMuted: "#8f95ab"
    foregroundSubtle: "#5d6479"
    border: "#ffffff14"
    danger: "#ff6b81"
}

Panel {
    position: "top"
    screen: "primary"

    // This bar's height, and how much desktop it holds.
    height: 46

    // Take that height out of the usable desktop so maximized windows stop below
    // the bar instead of hiding it.
    exclusive: true

    // One line. The shell builds the other three edges from it: a 6px arm down
    // each side and along the bottom, all reserving their own strip, so the
    // desktop ends up inset on all four sides.
    //
    // Four windows, not one full-screen overlay, because this machine's
    // presentation path rejects per-pixel alpha — a full-screen window would be
    // an opaque rectangle over your whole desktop. See docs/WINDOWS_API.md.
    wrap: true
    wrapSize: 6

    background: "background"
    padding: 0

    // -- Left: launcher, workspaces, and the active window -----------------
    left {
        Row {
            gap: 8
            padding: [0, 10]
            cross: "center"

            Text {
                text: "Apps"
                fontWeight: 700
                padding: [5, 12]
                radius: 8
                background: "surface"
                onClick: shell.open("launcher")
            }

            // -- Where workspace numbers would go ----------------------------
            //
            // Deliberately not here, and not because it is unfinished. Windows has
            // no supported way for a third-party shell to list or switch virtual
            // desktops: `IVirtualDesktopManager` is documented but can only *move*
            // a window, and the enumeration and switching live on an undocumented
            // interface that returns E_NOINTERFACE on this machine.
            //
            // A row of numbers that always reads "1" would look like a broken
            // workspace bar, so it is left out. To get one, bind these to whatever
            // virtual desktop tool you use — it has to be the thing that switches,
            // because the shell cannot:
            //
            //   Text { text: "1"  onClick: exec.run(["path/to/tool.exe", "1"]) }
            //   Text { text: "2"  onClick: exec.run(["path/to/tool.exe", "2"]) }
            //
            // `windows.active.title` below is the nearest real thing this shell
            // can tell you about where you are.

            // The foreground window's title, trimmed by the layout to whatever
            // room is left. Empty when nothing is focused, which is honest.
            Text {
                text: windows.active.title
                color: "foregroundMuted"
                visible: windows.active.title != ""
            }
        }
    }

    // -- Centre: now playing ------------------------------------------------
    center {
        Row {
            gap: 10
            cross: "center"

            // Real media. `media.title` and `media.artist` come from the SMTC
            // global session manager, which needs no package identity — the
            // per-app API does, and this is not that one. `media.playing` is true
            // for both playing and paused, so a paused track keeps its controls
            // instead of vanishing.
            //
            // The transport sends the real media keys as injected input, so
            // whatever is playing responds to them.
            Container {
                visible: media.playing
                gap: 10
                cross: "center"

                Column {
                    gap: 0
                    Text {
                        text: media.title
                        fontWeight: 600
                        color: "foreground"
                    }
                    Text {
                        text: media.artist
                        color: "foregroundSubtle"
                        fontSize: 11
                    }
                }

                Text {
                    text: "|<"
                    color: "foregroundMuted"
                    padding: [4, 8]
                    radius: 6
                    onClick: keys.send("PrevTrack")
                }
                Text {
                    // Paused shows a play glyph rather than a pause one, so the
                    // button always means "do the other thing".
                    text: media.status == "paused" ? ">|" : "||"
                    color: "foreground"
                    padding: [4, 9]
                    radius: 6
                    background: "surface"
                    onClick: keys.send("PlayPause")
                }
                Text {
                    text: ">|"
                    color: "foregroundMuted"
                    padding: [4, 8]
                    radius: 6
                    onClick: keys.send("NextTrack")
                }
            }

            // Shown only when nothing is playing, so the middle of the bar is not
            // simply empty. A bar with a hole in it looks broken; a bar that says
            // "nothing playing" looks deliberate.
            Row {
                visible: !media.playing
                gap: 6
                cross: "center"
                Text { text: "nothing playing"  color: "foregroundSubtle"  fontSize: 12 }
            }
        }
    }

    // -- Right: system state and controls -----------------------------------
    right {
        Row {
            gap: 14
            padding: [0, 12]
            cross: "center"

            // Terminal. `launch.open` goes through the shell, so it uses the
            // user's own PATH and terminal preference rather than guessing.
            Text {
                text: "term"
                color: "foregroundMuted"
                onClick: launch("wt")
            }

            Text {
                text: "wifi"
                color: network.connected ? "foreground" : "foregroundSubtle"
                visible: network.wifi
            }

            // Battery, only on a machine that has one. A desktop showing 0% is
            // worse than a desktop showing nothing.
            Row {
                visible: battery.present
                gap: 5
                cross: "center"
                Text {
                    text: battery.percentage + "%"
                    color: battery.charging ? "accent" : "foregroundMuted"
                }
                Text {
                    text: "+"
                    color: "accent"
                    visible: battery.charging
                }
            }

            Text { text: "vol -"  color: "foregroundMuted"  onClick: audio.lower() }
            Text { text: "vol +"  color: "foregroundMuted"  onClick: audio.raise() }

            Text { text: "|"  color: "border" }

            Clock { format: "HH:mm"  fontWeight: 600 }
        }
    }
}

// -- The launcher, opened on demand -----------------------------------------
// Not shown until `shell.open("launcher")`, so it costs nothing until used. The
// reserved space belongs to the bar only: a hidden panel has no window and
// therefore holds no space.
Panel {
    name: "launcher"
    hidden: true
    position: "top"
    screen: "primary"
    height: 232
    exclusive: false
    backdrop: "acrylic"
    background: "#151821f7"
    radius: 12
    padding: 14

    center {
        Column {
            gap: 10

            Text {
                text: "Run"
                fontWeight: 700
                fontSize: 15
                padding: [0, 2]
            }

            Container {
                gap: 8
                cross: "start"

                // Real launches through the shell, so PATH and the default
                // handler are the user's rather than this file's opinion.
                Text {
                    text: "Terminal"
                    padding: [8, 12]
                    radius: 8
                    background: "surface"
                    onClick: launch("wt")
                }
                Text {
                    text: "Notepad"
                    padding: [8, 12]
                    radius: 8
                    background: "surface"
                    onClick: launch("notepad")
                }
                Text {
                    text: "File Explorer"
                    padding: [8, 12]
                    radius: 8
                    background: "surface"
                    onClick: launch("explorer")
                }
                Text {
                    text: "Settings"
                    padding: [8, 12]
                    radius: 8
                    background: "surface"
                    onClick: launch("ms-settings:")
                }
                Text {
                    text: "Reload the shell config"
                    padding: [8, 12]
                    radius: 8
                    background: "surface"
                    onClick: shell.reload()
                }
                Text {
                    text: "Quit the shell"
                    padding: [8, 12]
                    radius: 8
                    background: "surface"
                    color: "danger"
                    onClick: shell.stop()
                }
            }
        }
    }
}
