// launcher.config — a run dialog, and a bar to open it from.
//
//     Shell.exe examples\launcher.config
//
// Shows:
//   * two panels: a small bar and a larger panel that is `hidden` at startup
//   * `shell.open` to build a surface on demand, and `shell.reload` to prove the
//     config round-trips through a handler
//   * the clipboard, which is what a run dialog is actually for
//   * `visible` driven by a system value, so a widget appears only when it means
//     something on this machine
//
// Open the launcher by clicking "Open" in the bar, or from a terminal with
//     shellctl open launcher

Theme {
    radius: 12
    fontSize: 14
    accent: "#7c9cff"
    background: "#101219f2"
    surface: "#1b1e29fa"
    foreground: "#e6e7ef"
    foregroundMuted: "#8b8fa3"
    border: "#ffffff14"
}

Panel {
    position: "top"
    height: 36
    background: "background"
    padding: 0

    left {
        Row {
            gap: 12
            padding: [0, 12]
            cross: "center"

            Text {
                text: "Open"
                fontWeight: 600
                color: "accent"
                onClick: shell.open("launcher")
            }
            Text { text: "close"  color: "foregroundMuted"  onClick: shell.reload() }
        }
    }

    center {
        Row { Clock { format: "HH:mm:ss"  color: "foregroundMuted" } }
    }

    right {
        Row {
            padding: [0, 12]
            // Only shown on a laptop, so a desktop build of this config does not
            // carry a meaningless 0% around.
            Text {
                text: battery.percentage + "%"
                color: "foregroundMuted"
                visible: battery.present
            }
        }
    }
}

// -------------------------------------------------------------------------- //
// The run dialog.
//
// `hidden: true` means this panel is compiled on every reload but no window
// exists for it until `shell.open("launcher")` asks. Nothing else in the shell
// knows what a launcher is.
// -------------------------------------------------------------------------- //

Panel {
    name: "launcher"
    hidden: true
    position: "top"
    width: 620
    height: 64
    anchorX: 0.5
    background: "surface"
    border: "border"
    borderWidth: 1
    radius: 14
    padding: 0

    content {
        Column {
            gap: 0
            padding: 0

            // The query line.
            Row {
                gap: 12
                padding: [0, 18]
                cross: "center"
                height: 64

                Text { text: ">"  color: "accent"  fontWeight: 700 }
                Text { text: "type a program or a path"  color: "foregroundMuted" }
            }

            // A hairline between the query and the results, drawn as a one-pixel
            // `Row` rather than as a border so it spans only the content.
            Row { height: 1  background: "border" }

            // Two worked examples. Both are real: pressing one actually starts
            // the program.
            Row {
                gap: 12
                padding: [10, 18]
                cross: "center"
                background: "surfaceAlt"
                radius: 8

                Text { text: "notepad"  color: "foreground" }
                Text { text: "open"  color: "accent"  fontWeight: 600  onClick: launch("notepad.exe") }
            }

            Row {
                gap: 12
                padding: [10, 18]
                cross: "center"
                radius: 8

                Text { text: "calculator"  color: "foreground" }
                Text {
                    text: "open"
                    color: "accent"
                    fontWeight: 600
                    onClick: launch("calc.exe")
                }
            }

            // The clipboard, the other half of what a run dialog is for.
            Row {
                gap: 12
                padding: [10, 18]
                cross: "center"
                radius: 8

                Text { text: "clipboard"  color: "foreground" }
                Text {
                    text: "copy the word launcher"
                    color: "foregroundMuted"
                    onClick: clipboard.set("launcher")
                }
            }
        }
    }
}
